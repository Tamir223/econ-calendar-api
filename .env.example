# --- RapidAPI integration ---
# Shared secret RapidAPI sends on every proxied request (Security tab in your RapidAPI
# provider dashboard). Leave unset to disable the check for local development.
RAPIDAPI_PROXY_SECRET=

# --- Upstream data sources ---
FOREXFACTORY_BASE_URL=https://nfs.faireconomy.media
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
HTTP_TIMEOUT_SECONDS=10

# --- Caching ---
CACHE_TTL_SECONDS=900

# --- Redis (rate limiting + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limit tiers (requests per calendar month) ---
RATE_LIMIT_FREE=50
RATE_LIMIT_BASIC=1000
RATE_LIMIT_PRO=10000
RATE_LIMIT_BUSINESS=100000
